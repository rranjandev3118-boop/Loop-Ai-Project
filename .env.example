# Database Configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connection_limit=10"

# NextAuth Configuration
NEXTAUTH_SECRET="replace-with-a-long-random-secret-min-32-characters"
NEXTAUTH_URL="https://your-domain.com"

# Anthropic AI Configuration
ANTHROPIC_API_KEY="your-anthropic-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Cron Job Security
CRON_SECRET="replace-with-a-long-random-secret-min-32-characters"

# Email Configuration (SMTP)
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM=""

# Environment
NODE_ENV="production"

# Set true only for demos. Must be false for real tenants.
DEMO_MODE="false"

# Optional: Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# Optional: Logging
LOG_LEVEL="info"
